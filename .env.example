# Telegram
BOT_TOKEN=123456:replace-me
OPERATOR_CHAT_ID=-1001234567890
DEV_CHAT_ID=-1001234567891

# LLM: ollama | google | none
LLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
GOOGLE_MODEL=gemma-4-26b-a4b-it
GEMINI_API_KEY=
LLM_TIMEOUT_S=45
LLM_RETRIES=2

# Embeddings: ollama | none
EMBED_BACKEND=ollama
EMBED_MODEL=embeddinggemma
EMBED_FALLBACK_MODEL=nomic-embed-text

# Incident detection
SIMILARITY_THRESHOLD=0.8
INCIDENT_THRESHOLD=3
INCIDENT_WINDOW_MIN=60

DB_PATH=data/demobank.db
LOG_LEVEL=INFO
